{
  "name": "@fitness-platform/root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "mobile": "cd apps/mobile && npm run start",
    "mobile:android": "cd apps/mobile && npm run android",
    "mobile:ios": "cd apps/mobile && npm run ios",
    "install-all": "npm install && npm run install-workspaces",
    "install-workspaces": "npm install --workspaces"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
