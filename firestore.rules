rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trainee invitations - trainers can manage their own invitations
    match /trainee_invitations/{invitationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
    }

    // Trainees - trainers can manage their own trainees
    match /trainees/{traineeId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
    }

    // Workouts - users can manage their own workouts
    match /workouts/{workoutId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Sessions - trainers can manage sessions for their trainees, trainees can read their own
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.trainerId || request.auth.uid == request.resource.data.traineeId);
    }

    // Availability Slots - trainers can manage their own availability
    match /availability_slots/{slotId} {
      allow read: if request.auth != null; // Anyone authenticated can view availability
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Booking Slots - trainers manage their slots, trainees can read to book
    match /booking_slots/{bookingId} {
      allow read: if request.auth != null; // Anyone authenticated can view booking slots
      allow write: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId ||
         request.auth.uid == resource.data.traineeId);
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.trainerId ||
         request.auth.uid == request.resource.data.traineeId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Recurring Bookings - trainers manage their recurring patterns
    match /recurring_bookings/{recurringId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Calendar Settings - trainers manage their own calendar settings
    match /calendar_settings/{trainerId} {
      allow read: if request.auth != null; // Anyone can view calendar settings
      allow write: if request.auth != null && request.auth.uid == trainerId;
    }

    // Session Templates - trainers manage their own templates
    match /session_templates/{templateId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Personal Records - trainers can manage, trainees can read their own
    match /personal_records/{recordId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
    }

    // Messages - users can read and write their own conversations
    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
    }

    // Conversations - users can read their own conversations
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow write: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.trainerId || request.auth.uid == request.resource.data.traineeId);
    }

    // Packages - trainers can manage their packages, trainees can read to purchase
    match /packages/{packageId} {
      allow read: if request.auth != null; // Anyone authenticated can view packages
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Trainee Packages - trainers and trainees can read their own package purchases
    match /trainee_packages/{traineePackageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.trainerId || request.auth.uid == request.resource.data.traineeId);
    }

    // Invoices - trainers can manage their invoices, trainees can read their own
    match /invoices/{invoiceId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow write: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
    }

    // Payments - trainers can view their payments, trainees can view and create their own
    match /payments/{paymentId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.traineeId;
      allow update: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Payment Accounts - trainers manage their own payment account settings
    match /payment_accounts/{trainerId} {
      allow read, write: if request.auth != null && request.auth.uid == trainerId;
    }

    // Transactions - trainers and trainees can read their own transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.trainerId || request.auth.uid == resource.data.traineeId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.trainerId;
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}